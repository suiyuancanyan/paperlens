{
  "name": "paperlens",
  "version": "1.2.0",
  "description": "A local AI paper-reading workspace with figure comparison and an interactive research canvas.",
  "license": "MIT",
  "repository": {"type":"git","url":"https://github.com/suiyuancanyan/paperlens.git"},
  "bugs": {"url":"https://github.com/suiyuancanyan/paperlens/issues"},
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-pdf-assets.mjs",
    "dev": "node server.mjs",
    "build": "vite build",
    "start": "node server.mjs --production",
    "test": "node --test tests/*.test.mjs",
    "translation:setup": "node scripts/setup-translation.mjs",
    "desktop:prepare": "npm run build && node scripts/prepare-desktop.mjs",
    "desktop:pack": "npm run desktop:prepare && electron-builder --win --dir --x64",
    "desktop:dev": "electron ."
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "dotenv": "^17.2.3",
    "katex": "^0.19.1",
    "lucide": "^0.468.0",
    "mammoth": "^1.11.0",
    "marked": "^18.1.2",
    "pdfjs-dist": "^5.4.394",
    "vite": "^7.2.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.7"
  },
  "main": "desktop/main.cjs"
}
