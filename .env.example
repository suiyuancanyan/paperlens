# Optional: configure your own compatible model service.
# You can also configure these in the application's settings.
PAPERLENS_API_BASE=
PAPERLENS_API_KEY=
PAPERLENS_MODEL=
PORT=4173
# Optional overrides for local Codex (usually leave empty).
PAPERLENS_CODEX_PATH=
PAPERLENS_CODEX_MODEL=gpt-6.1-sol
# Optional: an existing Python 3.10-3.13 environment with BabelDOC 0.6.4 and bitstring<5.
PAPERLENS_TRANSLATION_PYTHON=
# Optional: uv executable path (used to prepare an isolated Python 3.12 environment).
PAPERLENS_UV_PATH=
# Optional: local output directory for translated PDFs. Never commit this directory.
PAPERLENS_TRANSLATION_DIR=
